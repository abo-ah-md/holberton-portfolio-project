# BookPass API Configuration
# Copy this file to .env.development for local development

# ========================================
# API Endpoint Configuration
# ========================================
# For local development: http://localhost:8080
# For production: https://api.book-pass.com (default fallback)
VITE_API_URL=http://localhost:8080

# ========================================
# Moyasar Payment Gateway
# ========================================
# Get your keys from: https://moyasar.com/dashboard
# Test key format: pk_test_xxxxx
# Live key format: pk_live_xxxxx
VITE_MOYASAR_PUBLIC_KEY=pk_test_YOUR_TEST_KEY_HERE

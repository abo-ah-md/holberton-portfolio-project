#!/bin/bash
# Configuration file for Bookpass API Endpoint

# ========================================
# REQUIRED: SET YOUR API ENDPOINT
# ========================================
# Replace the value below with your backend API endpoint
# 
# Examples:
# - Local development: http://localhost:8080
# - Development server: https://api-dev.yourdomain.com
# - Production server: https://api.yourdomain.com
#
# Export this as an environment variable or update src/services/authService.js directly

export REACT_APP_API_BASE_URL="YOUR_API_ENDPOINT_HERE"

# For Vite (which this project uses), use:
export VITE_API_BASE_URL="YOUR_API_ENDPOINT_HERE"
